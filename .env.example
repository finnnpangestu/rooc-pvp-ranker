# ==========================================
# 1. DATABASE CONFIGURATION
# ==========================================

# OPSI A: Supabase (Cloud Database)
# Ganti dengan connection string dari Dashboard Supabase Anda:
DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# OPSI B: Local PostgreSQL via Docker
# Jika menjalankan aplikasi di Windows (pnpm dev / npm run dev):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guild-management

# Jika menjalankan aplikasi di dalam Docker Compose (docker compose up):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/guild-management

# Konfigurasi container PostgreSQL lokal (dibaca oleh docker-compose.yml):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guild-management
POSTGRES_PORT=5432

# ==========================================
# 2. AUTHENTICATION & JWT SECRET
# ==========================================
AUTH_SECRET=YOUR_RANDOM_SECRET_KEY
PAYLOAD_SECRET=YOUR_RANDOM_SECRET_KEY

# ==========================================
# 3. SUPABASE STORAGE (S3 COMPATIBLE)
# ==========================================
S3_ENDPOINT=https://<your-project-ref>.storage.supabase.co/storage/v1/s3
S3_BUCKET=media
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key
