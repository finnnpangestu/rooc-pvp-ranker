# Supabase PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET_KEY

# Supabase Storage (S3 API) Configuration
S3_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
S3_BUCKET=media
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key

