# ==============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================

# OPSI A: Production di Server VPS (Docker Internal Network)
DATABASE_URL=postgresql://postgres:your_password@postgres:5432/guild-management

# OPSI B: Development di Laptop Lokal (PostgreSQL via Docker)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/guild-management

# OPSI C: Cloud Database Eksternal (Supabase Pooler)
# DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Konfigurasi Container PostgreSQL (Dibaca oleh docker-compose):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=guild-management
POSTGRES_PORT=5432


# ==============================================================================
# 2. AUTHENTICATION & SECURITY
# ==============================================================================

# Kunci rahasia untuk menandatangani JWT Session (Ganti dengan string acak yang kuat)
AUTH_SECRET=generate_random_secret_minimum_32_characters_here

# (Opsional) Atur ke 'true' jika website sudah menggunakan domain HTTPS / SSL
# Biarkan 'false' jika masih diakses via IP langsung (HTTP)
COOKIE_SECURE=false


# ==============================================================================
# 3. S3 STORAGE (Media & File Upload)
# ==============================================================================
# Kompatibel dengan Supabase Storage, Cloudflare R2, atau AWS S3
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_BUCKET=storage
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
